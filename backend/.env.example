# Base de dados MySQL/MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=sigi_db
MYSQL_USER=root
MYSQL_PASSWORD=root
# Alternativa: defina DATABASE_URL para substituir as cinco variáveis acima.
# DATABASE_URL=mysql+pymysql://sigi_user:altere_esta_senha@127.0.0.1:3306/sigi_db

# Segurança: use valores longos, únicos e nunca faça commit do ficheiro .env.
SECRET_KEY=altere-por-uma-chave-secreta-longa
JWT_SECRET_KEY=altere-por-uma-chave-jwt-longa

# URL pública/local usada em links e comunicações.
APP_URL=192.168.88.236:3000

# Email (opcional; deixe SMTP_USER vazio para não configurar envio real).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Sabor Imbatível - Sistema de Gestão

# Gateways externos (opcionais). Sem URL/chave, o sistema não despacha SMS/WhatsApp.
SMS_GATEWAY_URL=
SMS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
